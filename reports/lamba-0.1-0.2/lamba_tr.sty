% lamba_tr.sty -- technical-report style for the Lamba report.
% Modeled on the widely used arXiv-style preprint template (the layout used by
% the Kimi K2/K3 technical reports): single column, Times text, small-caps
% title block, running header with "Technical Report".
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lamba_tr}[2026/10/03 Lamba technical report style]

\RequirePackage[T1]{fontenc}
\RequirePackage{mathptmx}
\RequirePackage[scaled=0.88]{helvet}
\RequirePackage[margin=1in,headheight=14pt]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{xcolor}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{graphicx}

\definecolor{lambablue}{HTML}{2A78D6}

% ---- running header ----
\newcommand{\@shorttitle}{}
\newcommand{\shorttitle}[1]{\renewcommand{\@shorttitle}{#1}}
\newcommand{\@reportlabel}{Technical Report}
\newcommand{\reportlabel}[1]{\renewcommand{\@reportlabel}{#1}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\@shorttitle}
\fancyhead[R]{\small\textsc{\@reportlabel}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}}

% ---- section headings ----
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{0.8em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{0.8em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\itshape}{\thesubsubsection}{0.8em}{}
\titlespacing*{\section}{0pt}{1.4ex plus .4ex}{0.8ex}
\titlespacing*{\subsection}{0pt}{1.1ex plus .3ex}{0.6ex}

\setlength{\parskip}{0.45em}
\setlength{\parindent}{0pt}

% ---- title block ----
\newcommand{\@subtitle}{}
\newcommand{\subtitle}[1]{\renewcommand{\@subtitle}{#1}}
\renewcommand{\maketitle}{%
  \thispagestyle{plain}%
  \begin{center}
    \vspace*{-0.5em}
    {\rule{\linewidth}{1.2pt}}\\[0.9em]
    {\Large\bfseries\scshape \@title\par}
    \ifx\@subtitle\@empty\else\vspace{0.4em}{\normalsize\scshape \@subtitle\par}\fi
    \vspace{0.7em}{\rule{\linewidth}{0.4pt}}\\[1.1em]
    {\normalsize\bfseries \@author\par}
    \vspace{0.3em}{\small \@date\par}
  \end{center}
  \vspace{0.6em}%
}

% ---- abstract ----
\renewenvironment{abstract}{%
  \begin{center}{\small\bfseries\scshape Abstract}\end{center}
  \vspace{-0.6em}\begin{quote}\small}{\end{quote}\vspace{0.6em}}

% ---- key-result box ----
\newenvironment{keybox}{%
  \par\smallskip\noindent\begin{minipage}{\linewidth}%
  \color{black}\vrule width 2pt\hspace{8pt}\begin{minipage}{\dimexpr\linewidth-10pt}\small}%
  {\end{minipage}\end{minipage}\par\medskip}
\endinput
